{"id": "fs47", "already_said": ["ex_surveillante"], "utterance": "Elle s'appelle comment, la surveillante ?", "label": {"type": "directive", "inner_type": null, "target": "out_of_scenario", "suggested_proposition": null, "options": null, "phase_hint": "substantive"}}
{"id": "fs48", "already_said": ["ex_cantine"], "utterance": "Est-ce que quelqu'un a fait tomber ton plateau à la cantine ?", "label": {"type": "option_posing", "inner_type": null, "target": "ex_plateau", "suggested_proposition": "quelqu'un a fait tomber son plateau", "options": null, "phase_hint": "substantive"}}
